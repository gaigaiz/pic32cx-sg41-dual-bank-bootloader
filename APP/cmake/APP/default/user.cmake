# User custom build steps (this file is not regenerated by MCC).
#
# Produce the raw APP binary from the toolchain-generated Intel HEX using the
# verified HEX-extraction script Tools/make_merged_bin.py.
#
# Why not objcopy section filtering: XC32 names sections with a "%nn" suffix
# (e.g. .text%28, .dinit%32, .rodata%90). An objcopy --only-section name
# whitelist cannot match those, so the unmatched sections come out zero-filled
# and the image does not run. The HEX script extracts by address range instead,
# keeping every main-Flash byte and skipping the 0x804000 config region.

# Locate the ELF target by prefix so the MCC-generated hash suffix does not
# need to be hard-coded here.
set(APP_default_elf_target "")
get_property(APP_default_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(_t ${APP_default_targets})
    if(_t MATCHES "^APP_default_image_")
        set(APP_default_elf_target ${_t})
    endif()
endforeach()

# This file lives at <repo>/APP/cmake/APP/default/.
set(APP_default_repo_root "${CMAKE_CURRENT_SOURCE_DIR}/../../../../")
set(APP_default_merge_script "${APP_default_repo_root}/Tools/make_merged_bin.py")

find_program(PYTHON_EXECUTABLE NAMES python python3 py
    DOC "Python interpreter running the HEX-to-binary extraction script")

if(NOT PYTHON_EXECUTABLE)
    message(WARNING "Python interpreter not found; APP raw bin is not exported automatically. Run Tools/make_merged_bin.py manually.")
elseif(NOT EXISTS "${APP_default_merge_script}")
    message(WARNING "Extraction script not found: ${APP_default_merge_script}; APP raw bin is not exported.")
else()
    # Run after the existing Bin2Hex target has produced default.hex.
    # The script reads both BL and APP HEX at fixed paths; the BL HEX must
    # already be built (see docs Bootloader dual-bank manual, section 5.2).
    add_custom_target(APP_default_ExportAppBin ALL
        COMMAND ${PYTHON_EXECUTABLE} "${APP_default_merge_script}"
        COMMENT "Extract APP raw bin from HEX (make_merged_bin.py)"
        DEPENDS APP_default_Bin2Hex)
    add_dependencies(APP_default_ExportAppBin APP_default_Bin2Hex)
endif()
