# User custom build steps (this file is not regenerated by MCC).
#
# Export a raw binary from the ELF after the build. Only main-flash sections
# are kept; the 0x804000 config-bit segments and RAM (.bss) segments are left
# out so the raw bin is not inflated by the address gap to those segments.

# Locate the ELF target by prefix so the MCC-generated hash suffix does not
# need to be hard-coded here.
set(APP_default_elf_target "")
get_property(APP_default_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
foreach(_t ${APP_default_targets})
    if(_t MATCHES "^APP_default_image_")
        set(APP_default_elf_target ${_t})
    endif()
endforeach()

set(APP_default_bin_name "app.bin")
set(APP_default_bin_path "${APP_default_output_dir}/${APP_default_bin_name}")

add_custom_command(TARGET ${APP_default_elf_target} POST_BUILD
    COMMAND ${OBJCOPY} -O binary
        --only-section=.vectors
        --only-section=.text
        --only-section=.text.*
        --only-section=.rodata
        --only-section=.rodata.*
        --only-section=.ARM.exidx
        --only-section=.dinit
        --only-section=.data
        $<TARGET_FILE:${APP_default_elf_target}>
        ${APP_default_bin_path}
    COMMENT "Export APP raw binary (filtered sections)")
